# Copie para .env.local (desenvolvimento) e configure as mesmas variáveis
# em Vercel > Settings > Environment Variables (produção).
# Os valores estão em Supabase > Project Settings > API.

# URL do projeto, ex: https://xxxxxxxxxxxx.supabase.co
SUPABASE_URL=

# Chave pública. Vai para o browser pela rota /api/config — protegida por RLS.
SUPABASE_ANON_KEY=

# Chave secreta. Ignora RLS: use SOMENTE no servidor, nunca no HTML.
SUPABASE_SERVICE_ROLE_KEY=
